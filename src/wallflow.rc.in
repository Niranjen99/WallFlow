// Resources built into wallflow.exe. CMake fills in the @...@ values (configure_file).
#include <winres.h>

// Icon id 1: the first icon in the file, so Explorer shows it for the .exe. The code loads it
// as MAKEINTRESOURCE(kAppIconId) (wallflow/win/resources.hpp).
1 ICON "@WALLFLOW_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WallFlow live wallpaper"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductName", "WallFlow"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "GPLv3, see LICENSE"
            VALUE "OriginalFilename", "wallflow.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
